# Copy to .env (chmod 600); replace all placeholders with generated values.
# scripts/dev-db.sh generates a complete .env for the native PostgreSQL path.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
CLINIC_TIMEZONE=Africa/Dar_es_Salaam
ALLOWED_ORIGINS=http://localhost:3000
PG_OWNER_PASSWORD=replace-with-generated-owner-password
APP_DB_ROLE=spartial_app
APP_DB_PASSWORD=replace-with-generated-app-password
DATABASE_ADMIN_URL=postgres://spartial_owner:replace-with-generated-owner-password@127.0.0.1:55432/spartial?sslmode=disable
DATABASE_URL=postgres://spartial_app:replace-with-generated-app-password@127.0.0.1:55432/spartial?sslmode=disable
# A local administrator connection used ONLY to create and drop isolated test databases.
TEST_DATABASE_URL=postgres://spartial_owner:replace-with-generated-owner-password@127.0.0.1:55432/postgres?sslmode=disable
SEED_ADMIN_PASSWORD=replace-with-generated-admin-password
SEED_RECEPTION_PASSWORD=replace-with-generated-reception-password
MINIO_ROOT_USER=spartial-development
MINIO_ROOT_PASSWORD=replace-with-generated-storage-password
