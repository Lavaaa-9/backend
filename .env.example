# Copy to .env (chmod 600); replace all placeholders with generated values.
# scripts/dev-db.sh generates a complete .env for the native PostgreSQL path.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
CLINIC_TIMEZONE=Africa/Dar_es_Salaam
ALLOWED_ORIGINS=http://localhost:3000
PG_OWNER_PASSWORD=replace-with-generated-owner-password
APP_DB_ROLE=spartial_app
APP_DB_PASSWORD=replace-with-generated-app-password
DATABASE_ADMIN_URL=postgres://spartial_owner:replace-with-generated-owner-password@127.0.0.1:55432/spartial_hms?sslmode=disable
DATABASE_URL=postgres://spartial_app:replace-with-generated-app-password@127.0.0.1:55432/spartial_hms?sslmode=disable
WORKER_DB_PASSWORD=replace-with-generated-worker-password
DATABASE_WORKER_URL=postgres://spartial_worker:replace-with-generated-worker-password@127.0.0.1:55432/spartial_hms?sslmode=disable
# A local administrator connection used ONLY to create and drop isolated test databases.
TEST_DATABASE_URL=postgres://spartial_owner:replace-with-generated-owner-password@127.0.0.1:55432/postgres?sslmode=disable
SEED_ADMIN_PASSWORD=replace-with-generated-admin-password
SEED_RECEPTION_PASSWORD=replace-with-generated-reception-password
MINIO_ROOT_USER=spartial-development
MINIO_ROOT_PASSWORD=replace-with-generated-storage-password
# Field-level encryption keyring (MFA secrets, later selected PHI). Comma-separated id:base64(32 bytes).
# Generate with: go run ./cmd/manage new-encryption-key
# Required in production; keep old ids during rotation.
PHI_ENCRYPTION_KEYS=dev1:replace-with-generated-base64-32-byte-key
PHI_ACTIVE_KEY_ID=dev1
# Privileged roles (administrator, privacy-reviewer) need an MFA-verified session. Forced true in production.
MFA_ENFORCE_PRIVILEGED=false
# Explicit trusted TLS proxies and clinic networks (IP or CIDR); empty trusts none.
TRUSTED_PROXIES=
CLINIC_NETWORKS=
# Default true in development, false in production. Production enablement needs a real signed-record reference.
CARE_POLICY_ENABLED=true
CARE_POLICY_APPROVAL_REF=
MFA_ENFORCE_REMOTE_CLINICAL=false
# Independent HMAC lookup key; generate privately with manage new-encryption-key. No placeholder secret is accepted.
IDENTIFIER_INDEX_KEY=
# No collector/provider defaults. HTTPS required for production exporter configuration.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Operational thresholds are disabled until explicitly configured (fixed 15-minute windows).
PRIVACY_READ_THRESHOLD=0
PRIVACY_MFA_THRESHOLD=0
# Shared password for the per-role synthetic test accounts (<role>@spartial.test); development only.
SEED_TEST_PASSWORD=replace-with-generated-test-password
# Development only: skips login/MFA rate limiting (ignored unless APP_ENV=development).
DISABLE_AUTH_RATE_LIMIT=false
