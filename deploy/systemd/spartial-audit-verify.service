[Unit]
Description=Verify Spartial audit seals
OnFailure=spartial-security-alert@%n.service
[Service]
Type=oneshot
User=spartial-maintenance
EnvironmentFile=/etc/spartial/maintenance.env
ExecStart=/opt/spartial/manage audit-verify
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
