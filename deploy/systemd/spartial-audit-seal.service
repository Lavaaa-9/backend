[Unit]
Description=Seal Spartial audit prefix using restricted maintenance-host credentials
OnFailure=spartial-security-alert@%n.service
[Service]
Type=oneshot
User=spartial-maintenance
EnvironmentFile=/etc/spartial/maintenance.env
ExecStart=/opt/spartial/manage audit-seal
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
